rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Keep this UID aligned with the administrator account in the app.
    function isAdmin() {
      return signedIn()
        && request.auth.uid == '4ZOJfbUjq8MYKb0fgOcoQAbEUOl';
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validNewPlayerProfile() {
      return request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points is int
        && request.resource.data.points == 0
        && request.resource.data.dncBalance is number
        && request.resource.data.dncBalance == 0
        && request.resource.data.level is int
        && request.resource.data.level == 1
        && request.resource.data.totalGames is int
        && request.resource.data.totalGames == 0
        && request.resource.data.totalEarnedPoints is int
        && request.resource.data.totalEarnedPoints == 0
        && request.resource.data.totalQuestionsAnswered is int
        && request.resource.data.totalQuestionsAnswered == 0
        && request.resource.data.lastSpiritClaimTime is int
        && request.resource.data.lastSpiritClaimTime == 0
        && request.resource.data.dailyClaimedLives is int
        && request.resource.data.dailyClaimedLives == 0
        && request.resource.data.lastDailyResetTime is int
        && request.resource.data.lastDailyResetTime == 0
        && request.resource.data.livesBalance is int
        && request.resource.data.livesBalance == 3
        && request.resource.data.avatar is string
        && request.resource.data.language in ['English', 'العربية', 'Français']
        && request.resource.data.createdAt is string;
    }

    function validPlayerStatsAfterUpdate() {
      return request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.totalEarnedPoints is int
        && request.resource.data.totalEarnedPoints >= 0
        && request.resource.data.totalQuestionsAnswered is int
        && request.resource.data.totalQuestionsAnswered >= 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.totalGames is int
        && request.resource.data.totalGames >= 0
        && request.resource.data.avatar is string
        && request.resource.data.language in ['English', 'العربية', 'Français']
        && request.resource.data.dncBalance == resource.data.dncBalance
        && request.resource.data.livesBalance == resource.data.livesBalance
        && request.resource.data.lastSpiritClaimTime == resource.data.lastSpiritClaimTime
        && request.resource.data.dailyClaimedLives == resource.data.dailyClaimedLives
        && request.resource.data.lastDailyResetTime == resource.data.lastDailyResetTime
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name;
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsUser(userId);

      allow create: if isAdmin()
        || (ownsUser(userId)
          && request.resource.data.keys().hasAll([
            'name', 'email', 'points', 'dncBalance', 'level',
            'totalGames', 'totalEarnedPoints', 'totalQuestionsAnswered',
            'lastSpiritClaimTime', 'dailyClaimedLives', 'lastDailyResetTime',
            'livesBalance', 'avatar', 'language', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'points', 'dncBalance', 'level',
            'totalGames', 'totalEarnedPoints', 'totalQuestionsAnswered',
            'lastSpiritClaimTime', 'dailyClaimedLives', 'lastDailyResetTime',
            'livesBalance', 'avatar', 'language', 'createdAt'
          ])
          && validNewPlayerProfile());

      // Players may update ordinary profile/game-stat fields only on their
      // own account. DNC, lives, identity and server-managed fields are locked.
      allow update: if isAdmin()
        || (ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'language', 'points', 'totalEarnedPoints',
            'totalQuestionsAnswered', 'level', 'totalGames',
            'avatar'
          ])
          && validPlayerStatsAfterUpdate());

      allow delete: if isAdmin();
    }

    // Questions are readable by guests and registered players.
    // Only the administrator may add, edit, or remove questions.
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // DNC credit history is immutable and visible only to its owner/admin.
    match /dncLedger/{entryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.playerUid == request.auth.uid);

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'playerUid', 'amount', 'type', 'createdAt', 'adminUid', 'note'
        ])
        && request.resource.data.keys().hasOnly([
          'playerUid', 'amount', 'type', 'createdAt', 'adminUid', 'note'
        ])
        && request.resource.data.playerUid is string
        && request.resource.data.amount is number
        && request.resource.data.amount > -1000000
        && request.resource.data.amount < 1000000
        && request.resource.data.amount != 0
        && request.resource.data.type in ['manual_credit', 'manual_adjustment']
        && ((request.resource.data.type == 'manual_credit'
              && request.resource.data.amount > 0)
            || (request.resource.data.type == 'manual_adjustment'
              && request.resource.data.amount < 0))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300;

      allow update, delete: if false;
    }

    // Deny every collection/document not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
